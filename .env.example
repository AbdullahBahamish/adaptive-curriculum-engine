# =============================================================================
# ACE AI Engine — Environment Configuration
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Service Identity ---------------------------------------------------------
APP_NAME="ACE AI Engine"
APP_VERSION="0.1.0"
ENVIRONMENT="development"       # development | staging | production
DEBUG=false

# --- Security (service-to-service auth) --------------------------------------
# This key must be sent by the C# backend in the X-Service-API-Key header.
# Generate a strong random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY="change-me-generate-a-strong-secret"

# --- PostgreSQL Database (owned by this AI service) --------------------------
DATABASE_URL="postgresql+psycopg2://ace_user:ace_password@localhost:5432/ace_db"
DB_ECHO_SQL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- LLM (optional — bonus AI features) -------------------------------------
# Set LLM_ENABLED=true to activate natural language enhancements.
LLM_ENABLED=false
LLM_PROVIDER="openai"           # openai | gemini | anthropic
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""

# --- Semantic Skill Matching (optional) -------------------------------------
# Set EMBEDDINGS_ENABLED=true to enable semantic skill matching.
EMBEDDINGS_ENABLED=false
EMBEDDINGS_MODEL="all-MiniLM-L6-v2"

# --- API Settings ------------------------------------------------------------
API_PREFIX="/api/v1"
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]